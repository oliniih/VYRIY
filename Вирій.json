{
  "name": "Vyriy Industries — Defense Tech Dark",
  "dataColors": [
    "#E5A93C",
    "#2EC4B6",
    "#4EA8DE",
    "#EF476F",
    "#8D99AE",
    "#F4A261",
    "#52B788",
    "#B56576"
  ],
  "background": "#0B0E11",
  "foreground": "#F3F6F9",
  "tableAccent": "#E5A93C",
  "good": "#2EC4B6",
  "neutral": "#E5A93C",
  "bad": "#EF476F",
  "maximum": "#EF476F",
  "center": "#E5A93C",
  "minimum": "#1B263B",
  "null": "#4A5568",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#13181F" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#232B36" } },
            "width": 1,
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F3F6F9" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#8D99AE" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#F3F6F9" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#A0AAB8" } },
            "titleColor": { "solid": { "color": "#8D99AE" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#A0AAB8" } },
            "titleColor": { "solid": { "color": "#8D99AE" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#1F2733" } },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": { "solid": { "color": "#A0AAB8" } },
            "titleText": "",
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0B0E11" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#13181F" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2A3441" } },
            "width": 1,
            "radius": 8
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#E5A93C" } },
            "fontSize": 22,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#A0AAB8" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#13181F" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#232B36" } },
            "width": 1,
            "radius": 8
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#E5A93C" } },
            "textSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#D8E0E8" } },
            "backgroundColor": { "solid": { "color": "#13181F" } },
            "textSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#202834" } },
            "gridHorizontalWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#E5A93C" } },
            "backColor": { "solid": { "color": "#171D26" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#F3F6F9" } },
            "backColorPrimary": { "solid": { "color": "#13181F" } },
            "fontColorSecondary": { "solid": { "color": "#F3F6F9" } },
            "backColorSecondary": { "solid": { "color": "#161C24" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#E5A93C" } },
            "backColor": { "solid": { "color": "#171D26" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#202834" } },
            "gridVerticalColor": { "solid": { "color": "#202834" } }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#E5A93C" } },
            "backColor": { "solid": { "color": "#171D26" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#D8E0E8" } },
            "backColor": { "solid": { "color": "#13181F" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#F3F6F9" } },
            "backColorPrimary": { "solid": { "color": "#13181F" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#E5A93C" } },
            "backColor": { "solid": { "color": "#171D26" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "labelStyle": "Data value, percent of total",
            "color": { "solid": { "color": "#F3F6F9" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}